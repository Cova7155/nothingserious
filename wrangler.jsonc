{
  "name": "godpack-dex",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "godpack-dex", "database_id": "05b0d394-223b-4f1c-9361-e2e9b67b43b3" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [
    { "pattern": "pokerarity.com", "custom_domain": true },
    { "pattern": "www.pokerarity.com", "custom_domain": true },
    { "pattern": "dex.godpack.live", "custom_domain": true }
  ],
  "triggers": { "crons": ["5 * * * *"] },
  "ratelimits": [
    { "name": "RL", "namespace_id": "4401", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_NEW", "namespace_id": "4402", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
